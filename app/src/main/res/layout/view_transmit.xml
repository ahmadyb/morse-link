<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <EditText
                android:id="@+id/send_message"
                style="@style/MonoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_edittext"
                android:gravity="top|start"
                android:hint="@string/send_message_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapCharacters|textNoSuggestions"
                android:minHeight="100dp"
                android:padding="12dp"
                android:textColorHint="@color/text_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/send_sos"
                    style="@style/ActionButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_button_danger"
                    android:text="@string/sos" />

                <Button
                    android:id="@+id/send_clear"
                    style="@style/ActionButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_surface"
                    android:text="@string/clear" />
            </LinearLayout>
        </LinearLayout>

        <!-- Outputs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_channels" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <ToggleButton
                    android:id="@+id/ch_torch"
                    style="@style/ChannelToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:checked="true"
                    android:textOff="@string/channel_torch"
                    android:textOn="@string/channel_torch" />

                <ToggleButton
                    android:id="@+id/ch_sound"
                    style="@style/ChannelToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:checked="true"
                    android:textOff="@string/channel_sound"
                    android:textOn="@string/channel_sound" />

                <ToggleButton
                    android:id="@+id/ch_screen"
                    style="@style/ChannelToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:checked="false"
                    android:textOff="@string/channel_screen"
                    android:textOn="@string/channel_screen" />

                <ToggleButton
                    android:id="@+id/ch_vibrate"
                    style="@style/ChannelToggle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:checked="false"
                    android:textOff="@string/channel_vibrate"
                    android:textOn="@string/channel_vibrate" />
            </GridLayout>
        </LinearLayout>

        <!-- Speed + tone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/send_speed" />

                <TextView
                    android:id="@+id/send_speed_value"
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/send_speed_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="35"
                android:progress="15" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/send_tone" />

                <TextView
                    android:id="@+id/send_tone_value"
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/send_tone_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="900"
                android:progress="300" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/send_start"
                style="@style/ActionButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transmit" />

            <Button
                android:id="@+id/send_stop"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/stop" />

            <CheckBox
                android:id="@+id/send_loop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:buttonTint="@color/accent"
                android:text="@string/loop"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical">

            <TextView
                android:id="@+id/send_status"
                style="@style/BodyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/send_status_idle"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/send_morse_preview"
                style="@style/MorseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:breakStrategy="simple"
                android:textIsSelectable="true" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
