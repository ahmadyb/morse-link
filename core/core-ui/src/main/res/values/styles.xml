<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- §12.2 typography -->
    <style name="Text.Morselink.Heading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Morselink.Tab" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Morselink.ListTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Text.Morselink.Meta" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/textSecondary</item>
    </style>

    <style name="Text.Morselink.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.Morselink.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/Text.Morselink.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.Morselink.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/Text.Morselink.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <style name="Widget.Morselink.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/Text.Morselink.Button</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
    </style>

    <style name="Widget.Morselink.Tab" parent="Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/Text.Morselink.Tab</item>
        <item name="tabIndicatorColor">@color/primary</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextColor">@color/textSecondary</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabMode">scrollable</item>
        <item name="android:background">@color/surface</item>
    </style>

    <style name="Widget.Morselink.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemTextAppearanceActive">@style/Text.Morselink.Meta</item>
        <item name="itemTextAppearanceInactive">@style/Text.Morselink.Meta</item>
        <item name="android:background">@color/surface</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.Morselink.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/background</item>
        <item name="titleTextColor">@color/textPrimary</item>
        <item name="navigationIconTint">@color/textPrimary</item>
    </style>

    <style name="Widget.Morselink.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
