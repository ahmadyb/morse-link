<?xml version="1.0" encoding="utf-8"?>
<!-- Date-group header with a select-all toggle for the whole group (§14.2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/unit"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/unit">

    <FrameLayout
        android:layout_width="24dp"
        android:layout_height="24dp">

        <ImageView
            android:id="@+id/check_ring"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/send_select_group"
            android:src="@drawable/bg_selection_ring" />

        <ImageView
            android:id="@+id/check_mark"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="@string/send_select_group"
            android:src="@drawable/ic_check"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/unit"
        android:layout_weight="1"
        android:textColor="@color/textPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

</LinearLayout>
