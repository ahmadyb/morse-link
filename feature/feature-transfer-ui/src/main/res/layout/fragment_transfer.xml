<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <TextView
        android:id="@+id/transport_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/unit_2"
        android:paddingEnd="@dimen/screen_padding"
        android:textColor="@color/textSecondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Collapsible card (§14.8). Two faces: the pairing QR while we wait for a
         receiver, and the peer we are connected to once the session is up. Both
         collapse to the title row, because a 220dp QR buries the transfer list
         underneath it on a phone. -->
    <LinearLayout
        android:id="@+id/pairing_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="@dimen/unit"
        android:layout_marginEnd="@dimen/screen_padding"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/unit_2"
        android:paddingTop="@dimen/unit"
        android:paddingEnd="@dimen/unit"
        android:paddingBottom="@dimen/unit"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/transport_label">

        <LinearLayout
            android:id="@+id/pairing_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pairing_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transfer_pairing_title"
                android:textColor="@color/textPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/pairing_toggle"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:contentDescription="@string/transfer_panel_collapse"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/textSecondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pairing_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/unit">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@color/surface"
                android:contentDescription="@string/transfer_qr_description"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/pairing_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/unit"
                android:text="@string/transfer_pairing_hint"
                android:textAlignment="center"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pairing_address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/unit_half"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pairing_panel" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingTop="@dimen/unit"
        android:paddingBottom="@dimen/unit_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_choose_files"
            style="@style/Widget.Morselink.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_choose_files"
            android:visibility="gone" />

        <!-- Icon only: it sits beside the labelled Cancel button, so a second
             word here reads as clutter rather than as help. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_minimise"
            style="@style/Widget.Morselink.Button.Text"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:text="@null"
            android:contentDescription="@string/action_minimise"
            android:tooltipText="@string/minimise_hint"
            app:icon="@drawable/ic_minimise"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Morselink.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_cancel" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
